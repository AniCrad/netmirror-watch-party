# Docker Compose reads .env automatically. Native Node needs --env-file (see docs).
# Local Compose: only expose to this computer by default.
BIND_ADDRESS=127.0.0.1
RELAY_PORT=8787

# Relay capacity (per process).
MAX_ROOMS=1000
MAX_MEMBERS=16
MAX_CONNECTIONS=2000

# Public HTTPS deployment only: replace these before starting production Compose.
DOMAIN=party.example.com
ACME_EMAIL=you@example.com
